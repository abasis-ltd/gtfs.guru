/target
**/*.rs.bk
.DS_Store

# Local AI coding sessions may contain full worktrees and conversation data.
.claude/
/golden_actual/
/real_world_actual/
/scripts/golden_manifest.tsv
/node_modules/
google-transitfeed/

# Python
__pycache__/
*.pyc

# Logs
*.log

# Local config
.env

# Local test files
/tmp/
/benchmark-feeds/
# Ignored so local scratch feeds stay out; the checked-in fixtures under it are
# tracked and were added with `git add -f`. The real-world/ feeds are the
# exception: only their manifest is tracked, and the zips this rule keeps
# untracked are fetched by scripts/fetch_real_world_feeds.py.
/test-gtfs-feeds/
/mobility-data-test-feeds/
/expected-nl/

# Benchmark and test outputs
/output*/
/verification_report*/
/benchmark-java/
/benchmark-rust/
/cargo-flamegraph.trace/
/dist/
/web-app/bin/

# Crate-local wasm-pack outputs duplicate the canonical browser packages under
# website/. Those website copies stay tracked because gtfs-guru-web embeds them
# at compile time and a clean cargo/Docker build must remain functional.
crates/gtfs_validator_wasm/pkg/
crates/gtfs_validator_wasm/pkg-mt/
crates/gtfs_validator_wasm/pkg-node/

# Tauri regenerates this on every Linux build
crates/gtfs_validator_gui/gen/schemas/linux-schema.json

# mkdocs build output
/site/
